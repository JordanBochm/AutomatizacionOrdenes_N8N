# ==============================================================================
# SUPPLYCHAIN MÉXICO (SEKO LOGISTICS) - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto y coloca tus llaves reales.
# NUNCA subas el archivo `.env` al repositorio ni expongas estas llaves en el frontend.

# ------------------------------------------------------------------------------
# 1. SEGURIDAD DE ACCESO Y AUTENTICACIÓN (CRÍTICO)
# ------------------------------------------------------------------------------
# API Key requerida para todos los endpoints de escritura y timbrado en FastAPI (/api/techship/*, /api/batches/*).
# Si no está configurada, el backend falla cerrado (HTTP 503).
API_KEY=tu_api_key_secreta_aqui

# ------------------------------------------------------------------------------
# 2. TECHSHIP API v3 (Generación y Timbrado de Guías KST / Kyndryl)
# ------------------------------------------------------------------------------
TECHSHIP_API_KEY=tu_techship_api_key_aqui
TECHSHIP_API_SECRET=tu_techship_api_secret_aqui
TECHSHIP_BASE_URL=https://api-us.techship.io
TECHSHIP_CLIENT_CODE=11

# ------------------------------------------------------------------------------
# 3. FEDEX TRACK API v1 (OAuth2 Client Credentials)
# ------------------------------------------------------------------------------
# Sandbox:    https://apis-sandbox.fedex.com
# Producción: https://apis.fedex.com
FEDEX_CLIENT_ID=tu_fedex_api_key_client_id
FEDEX_CLIENT_SECRET=tu_fedex_secret_key
FEDEX_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_LOCALE=es_MX

# ------------------------------------------------------------------------------
# 4. ESTAFETA API REST (OAuth2 Microsoft Entra CIAM + API Key)
# ------------------------------------------------------------------------------
# Token PROD: https://emexternalidpro.ciamlogin.com/<tenant-id>/oauth2/v2.0/token
# Scope:      api://<app-id>/.default
# IMPORTANTE: el WS labelrest (/labelrest/v1/wayBills) GENERA guías con costo y está
# bloqueado como endpoint de rastreo. ESTAFETA_TRACK_URL debe ser la URL del WS de Tracking.
ESTAFETA_CLIENT_ID=tu_estafeta_client_id
ESTAFETA_CLIENT_SECRET=tu_estafeta_client_secret
ESTAFETA_API_KEY=tu_estafeta_apikey_header
ESTAFETA_AUTH_URL=https://emexternalidpro.ciamlogin.com/<tenant-id>/oauth2/v2.0/token
ESTAFETA_OAUTH_SCOPE=api://<app-id>/.default
ESTAFETA_SUBSCRIBER_ID=
ESTAFETA_SALES_ORG=
ESTAFETA_SERVICE_ID=
ESTAFETA_LABEL_URL=https://apimlabelrest.estafeta.com/labelrest/v1/wayBills
ESTAFETA_TRACK_URL=https://apimwstrackingitem.estafeta.com/v1/ws_trackingitems/tracking-item-status

# ------------------------------------------------------------------------------
# 5. CACHÉ, CONCURRENCIA Y MODO SIMULACIÓN DE RASTREO
# ------------------------------------------------------------------------------
# Default seguro: false. Si es true, responde con datos simulados si faltan credenciales.
# Exportaciones Excel/PDF están estrictamente bloqueadas cuando hay datos simulados.
TRACKING_MOCK_FALLBACK=false

# Tiempo de vida en caché: 600s (10 min) para guías en tránsito y 3600s (60 min) para ENTREGADO
TRACKING_CACHE_TTL_SECONDS=600
TRACKING_CACHE_DELIVERED_TTL_SECONDS=3600

# Límite de consultas simultáneas por lote (máx. 50 guías por lote) y timeout HTTP
TRACKING_MAX_CONCURRENCY=8
TRACKING_HTTP_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 6. SEGURIDAD DE TRACKING API (OPCIONAL)
# ------------------------------------------------------------------------------
# Si defines un token aquí, los endpoints `/api/tracking/*` exigirán el header
# `Authorization: Bearer <TRACKING_API_AUTH_TOKEN>`.
TRACKING_API_AUTH_TOKEN=
